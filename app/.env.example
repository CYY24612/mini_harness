# 复制成 .env 再填。任选一家 OpenAI 兼容厂商 —— 只改 OPENAI_BASE_URL 就能切换。
#
#   DeepSeek     https://api.deepseek.com/v1                        模型 deepseek-chat / deepseek-reasoner
#   Kimi         https://api.moonshot.cn/v1                         模型 moonshot-v1-8k
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4                模型 glm-4-plus
#   本地 Ollama   http://localhost:11434/v1                          模型 你的本地模型名
#
# 注意：这个文件（.env.example）会提交进 git；真正带 key 的 .env 已被 .gitignore 排除。

OPENAI_API_KEY=sk-替换成你自己的key
OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat
